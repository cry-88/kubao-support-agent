# =============================================================================
# 哭包智能客服 · 生产环境变量
#
# 安装位置：/etc/kubao-support/kubao-support.env
#           权限必须 600，属主 root:kubao（含管理员口令，绝不能被其他用户读）
#
#   sudo install -d -m 750 -o root -g kubao /etc/kubao-support
#   sudo install -m 600 -o root -g kubao deploy/env/kubao-support.env.example \
#        /etc/kubao-support/kubao-support.env
#   sudo editor /etc/kubao-support/kubao-support.env    # 填口令后重启服务
#
# 生产强校验（不满足直接拒绝启动）：
#   - CS_ADMIN_CODE 必须显式设置且不是默认值
#   - CS_CORS_ORIGINS 不允许 *
#   - CS_STATIC_ROOT / CS_NOT_FOUND_PAGE 必须存在
# =============================================================================

NODE_ENV=production

# 只监听环回，对外由 Nginx 承担
PORT=8080
HOST=127.0.0.1

# ---------- 日志 ----------
CS_LOG_LEVEL=info
CS_LOG_FORMAT=json
CS_LOG_STACK=false

# ---------- 静态资源 ----------
CS_STATIC_CACHE=true
# CS_STATIC_ROOT=.                 # 相对 app/ 目录
# CS_NOT_FOUND_PAGE=404.html

# ---------- 数据 ----------
CS_DATA_DIR=/opt/kubao-support/data

# ---------- 可信代理（Nginx 与 Node 同机，必须开）----------
CS_TRUST_PROXY=true
CS_TRUSTED_PROXIES=127.0.0.1,::1

# ---------- 跨域：同源部署留空；前后端分离时列确切来源 ----------
CS_CORS_ORIGINS=

# ---------- 限流 ----------
CS_CHAT_RATE=12
CS_ANALYTICS_RATE=30
CS_LOGIN_MAX_PER_CODE=5
CS_LOGIN_MAX_GLOBAL=20
CS_LOGIN_MAX_PER_IP=10
CS_LOGIN_WINDOW_MIN=10

# 与 Nginx client_max_body_size 保持一致
CS_BODY_LIMIT_BYTES=1048576

# ---------- 口令（必填，否则服务拒绝启动）----------
# 建议：12 位以上，大小写 + 数字 + 符号；不要与任何其他系统复用
CS_ADMIN_CODE=
# 坐席口令：仅首次启动初始化 data/store.json 时生效
CS_AGENT_CODE_1=
CS_AGENT_CODE_2=

# ---------- 模型通道（可选，留空用本地应答引擎）----------
# CS_MODEL_PROVIDER=
# CS_MODEL_NAME=
# CS_MODEL_BASE_URL=
# CS_MODEL_API_KEY=
