# =============================================================================
# 哭包智能客服 · 环境变量示例
# -----------------------------------------------------------------------------
# 复制为 .env 后填写（.env 已被 .gitignore 忽略，切勿提交真实值）。
#
# 注意：本项目是纯静态前端，页面运行时 **不会** 读取 .env。
#       这里的变量用于：
#         1) 部署前替换 assets/config.js 中的 CLOUD_PUBLIC_CONFIG
#         2) 本地预览与 CI 的启动参数（PORT）
#         3) 初始化数据库时需要人工设置的口令（仅记录，不参与构建）
# =============================================================================

# ---------- 云服务公开配置（对应 assets/config.js）----------
# 应用发布域名下的数据面地址，形如 https://xxx.app.workbuddy.host
CLOUD_ENDPOINT=

# 应用标识键：只标识应用、本身不带权限，服务端仍会校验来源域名
CLOUD_PUBLISHABLE_KEY=

# OAuth Relay 地址（Web 端微信扫码 / WorkBuddy 账号登录用；不启用可留空）
CLOUD_OAUTH_RELAY_BASE_URL=

# 云服务资源 ID
CLOUD_RESOURCE_ID=

# ---------- 本地预览 / 部署 ----------
# 静态服务器监听端口，server.js 读取；平台部署时会自动注入 $PORT
PORT=8080

# ---------- 数据库初始化后需人工设置（不要写入仓库）----------
# 管理员口令：建库后执行
#   UPDATE cs_settings SET value = '你的强口令' WHERE key = 'admin_code';
DB_ADMIN_CODE=

# 坐席工号口令：建库后执行
#   INSERT INTO cs_agents (name, code) VALUES ('姓名', '工号口令');
DB_AGENT_CODE_1=
