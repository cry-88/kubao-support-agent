# =============================================================================
# 哭包智能客服 · 环境变量示例
# -----------------------------------------------------------------------------
# 复制为 .env 后填写（.env 已被 .gitignore 忽略，切勿提交真实值）。
# 本版本为「本地后端模式」：数据与大模型通道都由项目自带的 server.js 提供，
# 页面运行时不再直连云服务，因此只需要下面这几项。
# =============================================================================

# 服务端口（平台部署时会自动注入 $PORT）
PORT=8080

# 数据文件所在目录，默认是项目下的 data/
# CS_DATA_DIR=

# 管理员口令（首次启动写入 data/store.json；之后改这里不会再覆盖已有口令）
# 部署后请立刻改成自己的强口令
CS_ADMIN_CODE=kubao-admin-2026

# 坐席工号口令（首启初始化两位演示坐席：客服A / 客服B）
CS_AGENT_CODE_1=kubao-agent-1
CS_AGENT_CODE_2=kubao-agent-2
