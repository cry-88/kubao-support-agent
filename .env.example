# =============================================================================
# 哭包智能客服 · 环境变量总表（阶段3）
# -----------------------------------------------------------------------------
# 三套环境：development / test / production，用 NODE_ENV 切换。
#
# 加载优先级（后者覆盖前者）：
#   1. server/config.js 里的 profile 默认值
#   2. env/<NODE_ENV>.env      例：env/production.env   ← 按环境提供，建议入库模板
#   3. .env                    本地个人覆盖，不入库
#   4. 真实进程环境变量        部署平台/容器注入，优先级最高
#
# 起步方式：
#   cp env/development.env.example env/development.env
#   NODE_ENV=development node server.js
#
# 说明：本文件是"总表 + 说明"，实际生效的是 env/<NODE_ENV>.env 与 .env。
# =============================================================================

# ---------- 运行环境（必选其一）----------
# development | test | production
NODE_ENV=development

# ---------- 服务 ----------
PORT=8080
HOST=0.0.0.0

# 请求体上限（字节），默认：开发/测试 2MB，生产 1MB
# CS_BODY_LIMIT_BYTES=2097152

# ---------- 静态资源 ----------
# 静态根目录，相对项目根；生产可指向构建产物目录（如 public）
# CS_STATIC_ROOT=.
# 404 兜底页，相对静态根
# CS_NOT_FOUND_PAGE=404.html
# 是否允许浏览器缓存静态资源（HTML 始终不缓存）
# 开发/测试默认 false，生产默认 true
# CS_STATIC_CACHE=true

# ---------- 数据 ----------
# JSON 数据目录，默认 ./data（已在 .gitignore 中，不会入库）
# CS_DATA_DIR=data

# ---------- 前端接口地址 ----------
# 留空 = 同源相对路径（推荐）。仅当前后端分离部署时才填绝对地址，
# 例如 https://api.example.com；前端通过 window.__CS_API_BASE__ 读取
# CS_API_BASE=

# ---------- 跨域（CORS）----------
# 逗号分隔的来源白名单；生产禁止 *；留空 = 仅同源
# CS_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# 是否允许携带 Cookie（与 * 互斥）
# CS_CORS_CREDENTIALS=false

# ---------- 限流 ----------
# 每个访客每分钟可发多少条聊天消息（开发/测试默认 12，测试环境 60）
# CS_CHAT_RATE=12
# 每个操作者每分钟可做多少次分析查询
# CS_ANALYTICS_RATE=30
# 登录防爆破：同一口令窗口内失败上限 / 全局上限 / 窗口分钟数
# CS_LOGIN_MAX_PER_CODE=5
# CS_LOGIN_MAX_GLOBAL=20
# CS_LOGIN_WINDOW_MIN=10

# ---------- 日志 ----------
# debug | info | warn | error（开发默认 debug，测试 warn，生产 info）
# CS_LOG_LEVEL=debug

# ---------- 口令（生产必填，且不能是默认值）----------
# 首次启动写入 data/store.json；生产环境若为空或等于默认值，进程会拒绝启动
CS_ADMIN_CODE=
# 两个演示坐席的口令（仅首次初始化生效）
CS_AGENT_CODE_1=
CS_AGENT_CODE_2=

# ---------- 模型通道（可选）----------
# provider=local 时使用内置本地应答引擎（默认，无需任何密钥）
# 接入真实模型时填 provider/name/base_url/api_key，密钥只从环境读取，绝不入代码
# CS_MODEL_PROVIDER=local
# CS_MODEL_NAME=kubao-local-reply
# CS_MODEL_BASE_URL=
# CS_MODEL_API_KEY=
