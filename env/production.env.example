# =============================================================================
# 生产环境（NODE_ENV=production）
# 用途：Linux 服务器 + Nginx 反代 + systemd 常驻（阶段6 交付部署脚本）
#
# 强制校验（不满足直接拒绝启动，避免带病上线）：
#   1. CS_ADMIN_CODE 必须显式设置，且不能是默认占位值
#   2. CS_CORS_ORIGINS 不允许 *
#   3. CS_STATIC_ROOT / CS_NOT_FOUND_PAGE 必须存在
#
# 使用：cp env/production.env.example env/production.env，再填入真实值
#      真实口令不要写进仓库，改由 systemd EnvironmentFile 或密钥管理注入
# =============================================================================
NODE_ENV=production
PORT=8080
HOST=127.0.0.1

# 生产只留 info 及以上，避免 debug 刷屏拖慢 I/O
CS_LOG_LEVEL=info
CS_LOG_FORMAT=json
CS_LOG_STACK=false

# 静态资源允许浏览器缓存 1 小时（HTML 仍然强制 no-store）
CS_STATIC_CACHE=true

# 同源部署留空即可；前后端分离时列出确切来源，禁止 *
# CS_CORS_ORIGINS=https://support.example.com

# 可信代理：Nginx 与 Node 同机时必须开，否则限流会把所有请求算成 127.0.0.1
CS_TRUST_PROXY=true
CS_TRUSTED_PROXIES=127.0.0.1,::1

# 生产收紧限流
CS_CHAT_RATE=12
CS_ANALYTICS_RATE=30
CS_LOGIN_MAX_PER_CODE=5
CS_LOGIN_MAX_GLOBAL=20
CS_LOGIN_MAX_PER_IP=10
CS_LOGIN_WINDOW_MIN=10

# 请求体上限 1MB
CS_BODY_LIMIT_BYTES=1048576

# 数据目录（建议独立挂载，便于备份）
CS_DATA_DIR=/opt/kubao-support/data

# 管理员口令：必须是独立强口令（≥12 位，含大小写/数字/符号）
CS_ADMIN_CODE=

# 坐席口令：按实际人员配置
CS_AGENT_CODE_1=
CS_AGENT_CODE_2=

# 模型通道：接入真实模型时填；密钥通过 systemd EnvironmentFile 注入，不写在这里
# CS_MODEL_PROVIDER=
# CS_MODEL_NAME=
# CS_MODEL_BASE_URL=
# CS_MODEL_API_KEY=
