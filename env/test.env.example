# =============================================================================
# 测试环境（NODE_ENV=test）
# 用途：跑自动化用例、联调验收。要求：可重复、不吵、限流放宽。
# 使用：cp env/test.env.example env/test.env
# =============================================================================
NODE_ENV=test
PORT=8081
HOST=127.0.0.1

# 测试输出要干净，只留告警与错误
CS_LOG_LEVEL=warn

CS_STATIC_CACHE=false

# 自动化用例一般同源直连，无需跨域
CS_CORS_ORIGINS=

# 用例会连续打接口，限流放宽；真正的限流边界由用例里单独注入小阈值来验证
CS_CHAT_RATE=120
CS_ANALYTICS_RATE=120

# 测试库独立目录，别和生产/开发混
CS_DATA_DIR=data-test

# 测试口令由用例自己指定，不要写死生产口令
CS_ADMIN_CODE=test-admin-code
