# =============================================================================
# 开发环境（NODE_ENV=development）
# 用途：本地写代码、调页面。日志最啰嗦、不缓存、CORS 放开 localhost。
# 使用：cp env/development.env.example env/development.env
# =============================================================================
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# 本地调试建议 debug，能看到分析查询、配置加载等过程日志
CS_LOG_LEVEL=debug

# 本地改页面不需要缓存
CS_STATIC_CACHE=false

# 允许本机几个常用端口跨域（前端 8080、备用 8099）
CS_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8099

# 开发期放宽限流，方便连续点着测
CS_CHAT_RATE=30
CS_ANALYTICS_RATE=60

# 本地可以用默认口令；.env 里也可以覆盖成自己的
# CS_ADMIN_CODE=
